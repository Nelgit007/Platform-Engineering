# nginx.conf.template — reverse proxy config.
# nginx (port 80) is the only public entry point; it forwards
# /api/ requests to the internal app-service on port 5000.

server {
    listen 80;
    server_name _;

    location /api/ {
        proxy_pass http://127.0.0.1:5000/;
    }

    location / {
        return 200 'Multi-service environment is up.\n';
    }
}
